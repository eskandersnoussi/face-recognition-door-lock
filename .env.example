# Copy this file to ".env" and fill in your values. Never commit .env to GitHub.

# --- Camera ---
CAMERA_INDEX=0

# --- Recognition ---
# LBPH distance: lower = stricter. Raise it if you are often "unknown",
# lower it if strangers are accepted.
MATCH_THRESHOLD=65
REQUIRED_MATCHES=5

# --- Access policy ---
MAX_ATTEMPTS=3
ATTEMPT_SECONDS=4
UNLOCK_SECONDS=5
OWNER_TIMEOUT=120

# --- Lock: simulated | arduino | raspberrypi ---
LOCK_BACKEND=simulated
SERIAL_PORT=COM3
SERVO_PIN=18

# --- Owner alert: console | twilio ---
NOTIFIER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
OWNER_PHONE=
# true = attach the photo inside the message (MMS, needs PUBLIC_BASE_URL)
SEND_MMS=false

# --- Web server for the owner's Unlock / Deny page ---
SERVER_PORT=5000
# Leave empty to use this computer's Wi-Fi address (phone must be on the same Wi-Fi).
# To unlock from anywhere, expose the port (e.g. "ngrok http 5000") and put the https URL here.
PUBLIC_BASE_URL=
